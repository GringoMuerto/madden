{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": ["Edit(//**)"],
    "deny": ["WebSearch", "WebFetch"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": ["./madden", "./tests", "./docs", "./examples", "./sheets",
                    "./params.yaml", "./requirements.txt", "./README.md",
                    "./.env", "./.gitignore"]
    },
    "network": {
      "allowedDomains": ["api.the-odds-api.com", "github.com", "api.github.com",
                         "release-assets.githubusercontent.com", "api.open-meteo.com"]
    }
  }
}
